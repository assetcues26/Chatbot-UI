{
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://chatbot-backend-h6oj.onrender.com/docs"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://chatbot-backend-h6oj.onrender.com/docs/:path*"
    },
    {
      "source": "/redoc",
      "destination": "https://chatbot-backend-h6oj.onrender.com/redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "https://chatbot-backend-h6oj.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
